# ---- Server ----
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string

# ---- Encryption key for storing Telegram sessions / SMTP passwords at rest ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# ---- Telegram API credentials (shared by the whole app, NOT per-user) ----
# Get these for free at https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Default auto-delete delay for TG broadcast messages, in minutes
DEFAULT_AUTODELETE_MINUTES=15
